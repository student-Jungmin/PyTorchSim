# syntax=docker/dockerfile:1.4
#
# pytorchsim-triton-opt toolchain layer: the codegen route's stages 1-5 (ttir -> ttshared
# -> psto passes -> RISC-V ELF). Required, not optional -- `npu` has no other
# route. Kept a separate image from torchsim_base because it is ~1.8 GiB and
# moves on its own pin (thirdparty/pytorchsim-triton-opt.json + this file).
# The app image is ./Dockerfile with BASE_IMAGE pointed here.
#
# The repo is private, so the clone and the release downloads both need a token.
# It is a BuildKit secret, not a build-arg: build-args land in the image history.

ARG BASE_IMAGE=ghcr.io/psal-postech/torchsim_base:latest
FROM ${BASE_IMAGE}

ARG PSTO_REPO=PSAL-POSTECH/pytorchsim-triton-opt
ARG PSTO_REF=main

WORKDIR /workspace

# Not under $TORCHSIM_DIR: ./Dockerfile copies the PyTorchSim checkout over that
# path afterwards. extension_config reads PSTO_DIR, set below.
RUN --mount=type=secret,id=psto_token \
    TOKEN="$(cat /run/secrets/psto_token)" && \
    git clone "https://x-access-token:${TOKEN}@github.com/${PSTO_REPO}.git" \
      /workspace/pytorchsim-triton-opt && \
    git -C /workspace/pytorchsim-triton-opt checkout -q "${PSTO_REF}" && \
    git -C /workspace/pytorchsim-triton-opt remote set-url origin \
      "https://github.com/${PSTO_REPO}.git"

# restore.sh owns every pin (setup/versions.env) and unpacks LLVM 23, spike and
# the triton runtime into /workspace.
RUN --mount=type=secret,id=psto_token \
    GITHUB_TOKEN="$(cat /run/secrets/psto_token)" \
      /workspace/pytorchsim-triton-opt/setup/restore.sh --prebuilt

ENV PSTO_DIR=/workspace/pytorchsim-triton-opt
# The TOG builder parses the IR psto prints, so it has to link the SAME LLVM.
# This is the only place TORCHSIM_LLVM_PATH is set: torchsim_base ships a
# RISC-V LLVM but no longer names it, and LLVM 23 arrives with restore.sh above.
ENV TORCHSIM_LLVM_PATH=/workspace/LLVM_DIR/llvm-project/build/install/bin
# psto defaults to a separate fp8 spike and asks for zvfp8; the released spike
# has neither, and an unknown extension stops spike at startup. Drop once
# PSAL-POSTECH/riscv-isa-sim#7 is in the release.
ENV PSTO_SPIKE=/workspace/riscv-isa-sim/install/bin/spike
ENV PSTO_SPIKE_ISA=rv64gcv_zfh

# Fail the build, not the first CI job.
RUN python3 /workspace/pytorchsim-triton-opt/run.py doctor
